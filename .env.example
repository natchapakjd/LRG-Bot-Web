# Line Rangers Bot - Environment Configuration
# Copy this file to .env and update the values

# ===== Database (MySQL) =====
DB_DRIVER=mysql+aiomysql
DB_HOST=localhost
DB_PORT=51579
DB_USER=root
DB_PASSWORD=root
DB_NAME=lineranger_automation

# Optional full override URL
# DATABASE_URL=mysql+asyncmy://root:root@localhost:51579/lineranger_automation?charset=utf8mb4

# ===== Security Settings =====
# JWT secret key (generate a strong random key for production)
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-strong-random-secret-before-use

# Default admin credentials (only used if no admin exists)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

# ===== CORS Settings =====
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000,http://127.0.0.1:8000

# Comma-separated local roots where destructive/copy/export file operations are allowed.
# Keep account XML files under accounts/ or add your trusted folders here.
FILE_OPERATION_ROOTS=accounts,exports,backups

# ===== Rate Limiting =====
# Requests per minute for different endpoints
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LICENSE=10
RATE_LIMIT_GLOBAL=100

# ===== License Settings =====
# Set to true only for local development/testing.
LICENSE_BYPASS=false

# Online License Server URL (for future use)
# When ready, set LICENSE_BYPASS=false and configure this URL
LICENSE_SERVER_URL=

# ===== Build Mode =====
# Set to true when running as packaged .exe
IS_PRODUCTION_BUILD=false

# Backend bind address. Keep localhost unless you intentionally expose the app.
API_HOST=127.0.0.1
API_PORT=8000

# ===== ADB Settings =====
# Leave ADB_DEVICE_SERIAL empty to auto-use the only online device from `adb devices`.
ADB_PATH=adb
ADB_HOST=127.0.0.1
ADB_PORT=5558
ADB_DEVICE_SERIAL=
